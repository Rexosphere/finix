# Non-secret compose knobs. Copy to infra/compose/.env to override; docker
# compose reads that file automatically because it sits next to the compose file.
#
# Credentials are deliberately absent — they live in infra/compose/secrets/,
# generated by ./scripts/gen-secrets.sh and mounted as Docker secrets.

# Where service images come from, and which tag to run. Production deploys pin
# FINIX_IMAGE_TAG to sha-<short> so a release is a single immutable artifact set.
FINIX_IMAGE_PREFIX=ghcr.io/rexosphere/finix
FINIX_IMAGE_TAG=latest

# Grafana. The password is a Docker secret; only these two are configurable here.
FINIX_GRAFANA_ADMIN_USER=admin
FINIX_GRAFANA_ROOT_URL=http://localhost:3002

# Cross-app links, rendered by nginx at /env.js. Production sets the real hosts.
FINIX_WEB_URL=http://localhost:3000
FINIX_ADMIN_URL=http://localhost:3001

# Tracing. Left at 0 by default because Tempo only runs in the monitoring/full
# profiles — sampling nothing means the services never try to export. Set to 1.0
# alongside `make monitoring` to see a transfer cross every service in Grafana.
FINIX_TRACE_SAMPLE=0.0
FINIX_OTLP_ENDPOINT=http://tempo:4318/v1/traces
