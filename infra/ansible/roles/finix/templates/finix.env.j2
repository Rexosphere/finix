{# Managed by Ansible (infra/ansible/roles/finix). Passed to compose with
   --env-file by infra/deploy/deploy.sh. #}
# Public URLs. These are what turn the generic compose files into this
# deployment — the old setup achieved the same thing by sed-ing tracked HTML.
FINIX_AUTH_URL=https://{{ finix_auth_domain }}
FINIX_WEB_URL=https://{{ finix_domain }}
FINIX_ADMIN_URL=https://{{ finix_admin_domain }}

# Grafana. The admin password is a Docker secret, not a variable (ADR-0006).
FINIX_GRAFANA_ADMIN_USER=admin
FINIX_GRAFANA_ROOT_URL=https://{{ finix_grafana_domain }}

# Tracing. Tempo runs in the full profile here, so spans are exported. 1.0 is a
# demo-scale choice: at real traffic this belongs somewhere around 0.05-0.1.
FINIX_OTLP_ENDPOINT=http://tempo:4318/v1/traces
FINIX_TRACE_SAMPLE=1.0

# Image source. deploy.sh overrides FINIX_IMAGE_TAG with the sha- tag of the
# commit being deployed; this default only matters for a manual compose run.
FINIX_IMAGE_PREFIX=ghcr.io/rexosphere/finix
FINIX_IMAGE_TAG=latest
