#!/usr/bin/env bash
# Fast checks on staged files only. Installed by `make hooks`.
#
# Deliberately not a mirror of CI: a hook that takes 40 seconds gets bypassed
# with --no-verify, and a bypassed hook protects nothing. This runs formatters
# and a leak check — the things that are cheap to check and annoying to discover
# in review. CI remains the authority.
set -uo pipefail

staged() { git diff --cached --name-only --diff-filter=ACM -- "$@"; }

status=0
fail() { echo "pre-commit: $*" >&2; status=1; }

# --- credentials -----------------------------------------------------------
# The one check worth blocking on: a committed secret is not undone by a
# follow-up commit.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact || fail "gitleaks found a secret in the staged diff"
else
  # No gitleaks locally: fall back to the compose-specific rule CI also enforces.
  if git diff --cached -- infra/compose/docker-compose.yml \
      | grep -E '^\+\s+[A-Z_]*(PASSWORD|TOKEN|SECRET):\s*\S' \
      | grep -vE '_FILE:|__FILE:|\$\{' >/dev/null; then
    fail "a literal credential is being added to docker-compose.yml"
  fi
fi

# --- Go --------------------------------------------------------------------
if command -v gofmt >/dev/null 2>&1; then
  go_files=$(staged '*.go')
  if [ -n "$go_files" ]; then
    unformatted=$(gofmt -l $go_files)
    [ -z "$unformatted" ] || fail "gofmt would change: $unformatted"
  fi
fi

# --- Python ----------------------------------------------------------------
if command -v ruff >/dev/null 2>&1; then
  py_files=$(staged '*.py')
  if [ -n "$py_files" ]; then
    ruff check $py_files || fail "ruff found issues"
  fi
fi

# --- shell -----------------------------------------------------------------
sh_files=$(staged '*.sh')
for f in $sh_files; do
  [ -f "$f" ] || continue
  bash -n "$f" || fail "$f has a syntax error"
done

# --- YAML ------------------------------------------------------------------
if command -v python3 >/dev/null 2>&1; then
  yaml_files=$(staged '*.yml' '*.yaml')
  for f in $yaml_files; do
    [ -f "$f" ] || continue
    # !reset / !override are Compose merge tags, not standard YAML.
    grep -q '!reset\|!override' "$f" && continue
    python3 -c "import sys,yaml; yaml.safe_load(open(sys.argv[1]))" "$f" 2>/dev/null \
      || fail "$f is not valid YAML"
  done
fi

if [ "$status" -ne 0 ]; then
  echo "pre-commit: commit aborted (use --no-verify only if you know why)" >&2
fi
exit $status
